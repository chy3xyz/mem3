# Zig build artifacts
/zig-out/
/.zig-cache/
/zig-cache/

# Runtime data (per spec §FR-018)
/data/
# Default data-dir is ".", so a bare `mem3 serve`/`mem3 add` drops these in
# the repo root. They are runtime artifacts, never source.
/mem3.wal
/snapshot.bin

# OS noise
.DS_Store
Thumbs.db

# Editor
*.swp
*.swo
*~
.idea/
.vscode/

# Logs (per Constitution VII: silent by default)
*.log
logs/

# Benchmark output
bench-results.json

# Stray runtime dir from earlier bash typo (literal 0x16 SYN char)
//

# Long-run baseline harness output (default --out)
/longrun.jsonl

# Forgetting-metric harness output (default --out)
/forgetting_eval.jsonl

# Local git worktrees and agent scratch dirs
/.worktrees/
/.opencode/
